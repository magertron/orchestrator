    -- ── Machine / consumer roles ────────────────────────────────────────────────
    -- Purpose-built LOW-PRIVILEGE roles for service accounts (agent daemons,
    -- assistants) that consume governed egress — LLM providers and metered REST
    -- APIs — on behalf of end users. Deliberately minimal: they hold ONLY Read,
    -- which is the permission the egress proxies' Read guard requires (see
    -- handle_llm_proxy / handle_rest_token_proxy). They carry NO Deploy/Scale/
    -- Write/ManageRoles/Billing — a leaked daemon token must not be able to
    -- administer the platform.
    --
    -- These roles are GRANT TARGETS, not capability bundles. The role by itself
    -- grants access to NOTHING specific — actual access to a given LLM/REST
    -- provider comes from an explicit per-provider WILDCARD ALLOW row in
    -- mcp_tool_permissions (seeded at provider onboarding / managed in the Tool
    -- Explorer's access panel). So: role = "I am a consumer of this class",
    -- grant = "specifically this provider". A consumer SA with no grant is
    -- authenticated but authorized for nothing (the LLM lockdown returns
    -- llm_not_authorized).
    --
    -- Separation of concerns: llm-consumer (spend LLM keys) is distinct from
    -- api-consumer (call metered REST APIs) is distinct from mcp-consumer (invoke
    -- MCP tools), so an admin can grant exactly one class without the others.
    INSERT INTO roles (id, name, description, permissions, allowed_namespaces, system_role) VALUES
    ('system:llm-consumer', 'LLM Consumer', 'Service-account role for daemons/assistants that invoke governed LLM providers. Access to each LLM is granted explicitly per-provider; the role alone grants nothing.',
     '["Read"]',
     '["*"]', TRUE)
    ON CONFLICT (id) DO NOTHING;

    -- Agent. The role tool GRANTS are written against — an agent holds this
    -- and an administrator grants it specific tools per server. Held by
    -- mcp-assistant-sa (the docked assistant and the desktop daemon) and by
    -- customer agents.
    --
    -- ⚠ Read on five resource types and nothing more. The grants decide what it
    -- can reach; this role only makes it eligible to be granted.
    INSERT INTO roles (id, name, description, permissions, allowed_namespaces, system_role) VALUES
    ('system:agent', 'Agent', 'Service-account role for agents that invoke governed MCP tools. Tool access is granted explicitly per server; the role alone grants nothing.',
     '[{"actions":1,"namespace":"*","resource_name":"*","resource_type":0},
       {"actions":1,"namespace":"*","resource_name":"*","resource_type":1},
       {"actions":1,"namespace":"*","resource_name":"*","resource_type":2},
       {"actions":1,"namespace":"*","resource_name":"*","resource_type":4},
       {"actions":1,"namespace":"*","resource_name":"*","resource_type":5}]',
     '["*"]', TRUE)
    ON CONFLICT (id) DO NOTHING;

    -- Evidence reader. Held by mcp-evidence-agent so the evidence MCP server
    -- can read authority records and audit history as itself.
    --
    -- ⚠ THE Deploy BIT (actions 5 = Read|Deploy) IS LOAD-BEARING AND MISNAMED.
    -- handle_turn_evidence() gates on Action::Deploy as the platform's stand-in
    -- for "this is an operator action", the same way ~41 other handlers do.
    -- Removing it does not narrow this credential, it breaks it — and the
    -- symptom is a 403 that reads like a bug in the MCP server.
    --
    -- 257 on AuditLog is Read|AuditRead.
    INSERT INTO roles (id, name, description, permissions, allowed_namespaces, system_role) VALUES
    ('system:evidence-reader', 'Evidence reader', 'Read authority records and audit history; deploys nothing.',
     '[{"actions":5,"namespace":"*","resource_name":"*","resource_type":0},
       {"actions":257,"namespace":"*","resource_name":"*","resource_type":3}]',
     '["*"]', TRUE)
    ON CONFLICT (id) DO NOTHING;

