#!/usr/bin/env python3
"""czartup - Magertron(TM) Czartup from the terminal. The same verbs as in Cursor.

  czartup login [MAGERTRON_URL]         sign in through your browser (as in Cursor); remembers the URL
  czartup logout                        forget your sign-in on this machine
  czartup whoami                        which Magertron and URL this machine is signed in to
  czartup commands [--ide NAME] [--remove]   add the /czartup-... commands to Cursor, Claude Code, Codex

  czartup list                          the saved Czarters, and whether each is valid
  czartup describe "what the app does"  draft a Czarter from plain words (saves nothing)
  czartup describe "..." --save         draft it and save it
  czartup show NAME                     the Czarter, as YAML
  czartup status NAME                   where it stands, and the next step
  czartup setup NAME                    preview: what setup would change (changes nothing)
  czartup setup NAME --yes              make those changes (needs a Magertron admin)
  czartup verify NAME                   prove it against the live platform (read-only)
  czartup build NAME [--dir DIR]        write the hand-over pack into DIR (default: here)
  czartup update NAME [--dir DIR]       the same: write the latest pack over the old one
  czartup icon NAME FILE.png [--server S]   give the app (or one server) its icon
  czartup retire NAME [--idp] [--yes]   preview, then remove what setup created (needs an admin);
                                        --idp also removes the app from Auth0 (people's accounts stay)

Sign-in is the same MCP OAuth Cursor uses: your own account and MFA, in your browser. Czartup acts as
you, so you can do exactly what your Magertron roles allow, and every change is audited to you. The
sign-in shows in the console under Security > Connections as "Czartup CLI", where it can be revoked.

  Sign-in and URL are kept in ~/.czarter/cli.json (chmod 600). Tokens are never printed.
  For CI: set MAGERTRON_TOKEN (and CZARTUP_URL) instead of logging in.
Exit status: 0 when the step succeeded (or verify passed), 1 otherwise.
"""
import base64, hashlib, http.server, json, os, pathlib, re, secrets, stat, sys, threading, time
import urllib.error, urllib.parse, urllib.request, webbrowser

CONF = pathlib.Path("~/.czarter/cli.json").expanduser()
UA = "czartup-cli/1"
NAMESPACE = os.environ.get("CZARTUP_NAMESPACE", "mcp-prod")
USAGE = __doc__.split("\n\n")[1] + "\n\n" + __doc__.split("\n\n")[2]


# ---------- config (~/.czarter/cli.json, private) ----------

def load():
    if not CONF.exists():
        return {}
    if CONF.stat().st_mode & (stat.S_IRWXG | stat.S_IRWXO):
        sys.exit(f"{CONF} is readable by others - run: chmod 600 {CONF}")
    return json.loads(CONF.read_text() or "{}")


def save(c):
    CONF.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    CONF.touch(mode=0o600, exist_ok=True)
    CONF.chmod(0o600)
    CONF.write_text(json.dumps(c, indent=1))


def fetch(method, url, data=None, headers=None, form=False):
    h = {"User-Agent": UA, "Accept": "application/json", **(headers or {})}
    body = None
    if data is not None:
        body = urllib.parse.urlencode(data).encode() if form else json.dumps(data).encode()
        h["Content-Type"] = "application/x-www-form-urlencoded" if form else "application/json"
    req = urllib.request.Request(url, data=body, method=method, headers=h)
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            raw = r.read()
            return r.status, r.headers, raw
    except urllib.error.HTTPError as e:
        return e.code, e.headers, e.read()
    except urllib.error.URLError as e:
        sys.exit(f"could not reach {url}: {e.reason}")


def jget(url):
    st, _, raw = fetch("GET", url)
    if st != 200:
        return None
    try:
        return json.loads(raw)
    except ValueError:
        return None


# ---------- login: MCP OAuth (discovery, dynamic registration, PKCE, loopback) ----------

def discover(mcp_url):
    """The authorization server for Czartup's MCP endpoint, the way Cursor finds it."""
    st, hdr, _ = fetch("POST", mcp_url, {"jsonrpc": "2.0", "id": 0, "method": "ping"},
                      {"Accept": "application/json, text/event-stream"})
    meta = None
    m = re.search(r'resource_metadata="([^"]+)"', (hdr or {}).get("WWW-Authenticate", "") or "")
    if m:
        meta = jget(m.group(1))
    if not meta:
        u = urllib.parse.urlparse(mcp_url)
        for path in ("/.well-known/oauth-protected-resource" + u.path.rstrip("/"),
                     "/.well-known/oauth-protected-resource"):
            meta = jget(f"{u.scheme}://{u.netloc}{path}")
            if meta:
                break
    issuer = ((meta or {}).get("authorization_servers") or [None])[0]
    if not issuer:
        u = urllib.parse.urlparse(mcp_url)
        issuer = f"{u.scheme}://{u.netloc}"
    i = urllib.parse.urlparse(issuer)
    for path in (f"/.well-known/oauth-authorization-server{i.path.rstrip('/')}",
                 f"{i.path.rstrip('/')}/.well-known/oauth-authorization-server",
                 f"{i.path.rstrip('/')}/.well-known/openid-configuration"):
        asm = jget(f"{i.scheme}://{i.netloc}{path}")
        if asm and asm.get("authorization_endpoint") and asm.get("token_endpoint"):
            return asm
    sys.exit(f"could not find how to sign in to {mcp_url} (no OAuth metadata) - is Czartup connected on that Magertron?")


