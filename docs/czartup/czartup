IDE_DIRS = {"Cursor": "~/.cursor/commands", "Claude Code": "~/.claude/commands", "Codex": "~/.codex/prompts"}


def install_commands(args):
    only = opt(args, "--ide", "")
    remove = flag(args, "--remove")
    done = 0
    for ide, d in IDE_DIRS.items():
        home = pathlib.Path(d).expanduser()
        if only and only.lower() not in ide.lower():
            continue
        if not only and not home.parent.exists():       # that IDE is not installed for this user
            continue
        home.mkdir(parents=True, exist_ok=True)
        for name, (desc, body) in IDE_COMMANDS.items():
            f = home / f"{name}.md"
            if remove:
                f.unlink(missing_ok=True)
                continue
            # The first body line is what Cursor shows in its "/" menu: make it the plain description.
            f.write_text(f"---\ndescription: {desc}\nargument-hint: [name or details]\n---\n\n{desc}.\n\n{body}\n")
        done += 1
        print(f"{'removed from' if remove else 'installed in'} {ide}: {home} ({len(IDE_COMMANDS)} commands)")
    if not done:
        print("no supported IDE found (Cursor, Claude Code, Codex) - use --ide NAME to install anyway")
        return 1
    if not remove:
        print("Type / in the IDE's chat: /czartup-new, /czartup-setup, /czartup-build, /czartup-verify ...")
    return 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE)
        return 0
    verb, args = argv[0], argv[1:]

    if verb == "login":
        return login(args[0] if args else "")
    if verb == "logout":
        return logout()
    if verb == "whoami":
        c = load()
        print(f"{c.get('base') or 'not set'}  ({c.get('mcp_url') or '-'})  "
              + ("signed in" if c.get("access_token") else "not signed in"))
        return 0
    if verb == "commands":
        return install_commands(args)
    if verb == "list":
        return say(*call("list_czarters"))
    if verb == "describe":
        keep = flag(args, "--save")
        (text,) = need(args, 1, 'describe "what the app does" [--save]')
        blocks, err = call("describe_app", text=text)
        rc = say(blocks, err)
        if err or not keep:
            return rc
        m = re.search(r"```yaml\n(.*?)```", text_of(blocks), re.S)
        if not m:
            sys.exit("no draft to save")
        print()
        return say(*call("save_czarter", yaml=m.group(1)))
    if verb == "show":
        (name,) = need(args, 1, "show NAME")
        blocks, err = call("get_czarter", name=name)
        text = text_of(blocks)
        m = re.search(r"```ya?ml\n(.*?)```", text, re.S)
        print((m.group(1) if m else text).rstrip())
        return 1 if err else 0
    if verb == "status":
        (name,) = need(args, 1, "status NAME")
        return say(*call("czarter_status", name=name))
    if verb == "setup":
        yes = flag(args, "--yes")
        (name,) = need(args, 1, "setup NAME [--yes]")
        if not yes:
            rc = say(*call("setup_preview", name=name))
            print(f"\nNothing was changed. To make these changes: czartup setup {name} --yes")
            return rc
        rc = say(*call("setup_run", name=name, confirm=True))
        print(f"\nIf it is still running: czartup status {name}")
        return rc
    if verb == "retire":
        yes = flag(args, "--yes")
        keep = flag(args, "--keep-servers")
        idp = flag(args, "--idp")
        (name,) = need(args, 1, "retire NAME [--idp] [--yes] [--keep-servers]")
        kw = {"name": name, "confirm": yes}
        if keep:
            kw["keep_servers"] = True
        if idp:
            kw["remove_idp"] = True
        blocks, err = call("retire", **kw)
        out = re.sub(r"\n*Nothing was changed\.\s*$", "", text_of(blocks).strip())
        if out:
            print(out)
        if not yes and not err:
            print(f"\nNothing was changed. To retire it: czartup retire {name}{' --idp' if idp else ''} --yes")
        return 1 if err else 0
    if verb == "verify":
        (name,) = need(args, 1, "verify NAME")
        blocks, err = call("verify", name=name)
        rc = say(blocks, err)
        failed = re.search(r"\b(\d+) failed\b", text_of(blocks))
        return 1 if rc or (failed and failed.group(1) != "0") else 0
    if verb in ("build", "update"):
        folder = opt(args, "--dir", ".")
        (name,) = need(args, 1, f"{verb} NAME [--dir DIR]")
        return write_pack(name, folder)
    if verb == "icon":
        server = opt(args, "--server", "")
        name, f = need(args, 2, "icon NAME FILE.png [--server S]")
        data = base64.b64encode(pathlib.Path(f).expanduser().read_bytes()).decode()
        kw = {"name": name, "image_base64": data}
        if server:
            kw["server"] = server
        return say(*call("set_icon", **kw))
    print(f"unknown verb: {verb}\n\n{USAGE}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
