def banner():
    """The Magertron(TM) mark on stderr, when a person is watching: stdout stays clean for pipes.
    The mark is Magertron blue unless NO_COLOR is set."""
    if not sys.stderr.isatty():
        return
    blue, reset = ("", "") if os.environ.get("NO_COLOR") else ("\033[38;5;75m", "\033[0m")
    for line in BANNER:
        print(f"{blue}{line[:9]}{reset}{line[9:]}", file=sys.stderr)
    print(file=sys.stderr)


def login(base):
    banner()
    c = load()
    base = (base or c.get("base") or "").rstrip("/")
    if not base:
        sys.exit("usage: czartup login https://your-magertron   (the address you open the console or portal at)")
    if not base.startswith("https://"):
        base = "https://" + base.split("://")[-1]
    mcp_url = os.environ.get("CZARTUP_URL") or f"{base}/mcp/{NAMESPACE}/czartup/"
    asm = discover(mcp_url)

    # A loopback port for the browser to come back to.
    srv = http.server.HTTPServer(("127.0.0.1", 0), None)
    port = srv.server_address[1]
    redirect = f"http://127.0.0.1:{port}/callback"

    client_id = c.get("client_id") if c.get("issuer") == asm.get("issuer") and c.get("base") == base else None
    if not client_id:
        if not asm.get("registration_endpoint"):
            sys.exit("this Magertron does not offer client registration for MCP clients")
        st, _, raw = fetch("POST", asm["registration_endpoint"], {
            "client_name": "Czartup CLI", "redirect_uris": ["http://127.0.0.1/callback", redirect],
            "grant_types": ["authorization_code", "refresh_token"], "response_types": ["code"],
            "token_endpoint_auth_method": "none"})
        if st not in (200, 201):
            sys.exit(f"could not register the Czartup CLI (HTTP {st}): {raw[:200].decode('utf-8', 'replace')}")
        client_id = json.loads(raw)["client_id"]

    verifier = secrets.token_urlsafe(48)
    state = secrets.token_urlsafe(16)
    got = {}

    class Back(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
            got.update({k: v[0] for k, v in q.items()})
            ok = "code" in got and got.get("state") == state
            body = (b"<h2>Signed in to Czartup.</h2><p>You can close this tab and go back to the terminal.</p>" if ok else
                    b"<h2>Sign-in did not complete.</h2><p>Go back to the terminal.</p>")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, *a):
            pass

    srv.RequestHandlerClass = Back
    url = asm["authorization_endpoint"] + "?" + urllib.parse.urlencode({
        "response_type": "code", "client_id": client_id, "redirect_uri": redirect, "state": state,
        "code_challenge": base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).decode().rstrip("="),
        "code_challenge_method": "S256", "resource": mcp_url})
    print(f"Opening your browser to sign in to {base} ...")
    print(f"If it does not open, go to:\n  {url}")
    webbrowser.open(url)
    t = threading.Thread(target=srv.handle_request, daemon=True)
    t.start()
    t.join(300)
    srv.server_close()
    if got.get("error"):
        sys.exit(f"sign-in refused: {got.get('error_description') or got['error']}")
    if "code" not in got or got.get("state") != state:
        sys.exit("sign-in did not complete (no answer from the browser within 5 minutes)")

    st, _, raw = fetch("POST", asm["token_endpoint"], {
        "grant_type": "authorization_code", "code": got["code"], "redirect_uri": redirect,
        "client_id": client_id, "code_verifier": verifier, "resource": mcp_url}, form=True)
    if st != 200:
        sys.exit(f"could not finish sign-in (HTTP {st}): {raw[:200].decode('utf-8', 'replace')}")
    tok = json.loads(raw)
    save({"base": base, "mcp_url": mcp_url, "issuer": asm.get("issuer"), "token_endpoint": asm["token_endpoint"],
          "client_id": client_id, "access_token": tok["access_token"], "refresh_token": tok.get("refresh_token", ""),
          "expires_at": time.time() + float(tok.get("expires_in") or 3600)})
    print(f"Signed in to Czartup at {base}.")
    return 0


def logout():
    c = load()
    if c:
        save({k: v for k, v in c.items() if k in ("base", "mcp_url")})
    print("Signed out on this machine. To end the sign-in everywhere, revoke \"Czartup CLI\" under Security > Connections.")
    return 0


def access():
    """(mcp_url, token): the environment for CI, else the saved sign-in, renewed when it is near its end."""
    if os.environ.get("MAGERTRON_TOKEN", "").strip():
        url = os.environ.get("CZARTUP_URL") or load().get("mcp_url")
        if not url:
            sys.exit("with MAGERTRON_TOKEN, also set CZARTUP_URL (e.g. https://your-magertron/mcp/mcp-prod/czartup/)")
        return url, os.environ["MAGERTRON_TOKEN"].strip()
    c = load()
    if not c.get("access_token"):
        sys.exit("not signed in - run: czartup login https://your-magertron")
    if time.time() > c.get("expires_at", 0) - 60:
        if not c.get("refresh_token"):
            sys.exit("your sign-in has ended - run: czartup login")
        st, _, raw = fetch("POST", c["token_endpoint"], {"grant_type": "refresh_token", "refresh_token": c["refresh_token"],
                                                      "client_id": c["client_id"], "resource": c["mcp_url"]}, form=True)
        if st != 200:
            sys.exit("your sign-in has ended - run: czartup login")
        tok = json.loads(raw)
        c.update(access_token=tok["access_token"], refresh_token=tok.get("refresh_token") or c["refresh_token"],
                 expires_at=time.time() + float(tok.get("expires_in") or 3600))
        save(c)
    return c["mcp_url"], c["access_token"]


# ---------- MCP calls ----------

_S = {"id": 0, "session": None}


def rpc(url, token, method, params=None, notify=False):
    body = {"jsonrpc": "2.0", "method": method, "params": params or {}}
    if not notify:
        _S["id"] += 1
        body["id"] = _S["id"]
    h = {"Authorization": "Bearer " + token, "Accept": "application/json, text/event-stream"}
    if _S["session"]:
        h["Mcp-Session-Id"] = _S["session"]
    st, hdr, raw = fetch("POST", url, body, h)
    if hdr and hdr.get("Mcp-Session-Id"):
        _S["session"] = hdr.get("Mcp-Session-Id")
    if st == 401:
        sys.exit("Czartup says your sign-in has ended (401) - run: czartup login")
    if st == 403:
        why = raw[:300].decode("utf-8", "replace")
        if "tool-approval" in why:
            raise Unapproved(why)
        sys.exit(f"Magertron refused this (403): {why}")
    if notify:
        return None
    if st != 200:
        sys.exit(f"Czartup answered HTTP {st}: {raw[:300].decode('utf-8', 'replace')}")
    text = raw.decode("utf-8", "replace").strip()
    if not text.startswith("{"):                       # an event stream: the last data: line
        lines = [l[5:].strip() for l in text.splitlines() if l.startswith("data:")]
        text = lines[-1] if lines else "{}"
    msg = json.loads(text)
    if "error" in msg:
        sys.exit(f"Czartup: {msg['error'].get('message', msg['error'])}")
    return msg.get("result") or {}


class Unapproved(Exception):
    """403 tool-approval: the tool is new to Magertron (Czartup was just upgraded)."""


def call(tool, **args):
    url, token = access()
    if not _S["session"] and _S["id"] == 0:
        rpc(url, token, "initialize", {"protocolVersion": "2025-06-18", "capabilities": {},
                                      "clientInfo": {"name": "czartup-cli", "version": "1"}})
        rpc(url, token, "notifications/initialized", notify=True)
    try:
        res = rpc(url, token, "tools/call", {"name": tool, "arguments": args})
    except Unapproved as e:
        # Czartup approves its own new tools when an admin first reaches it after an upgrade.
        # Reach it through a tool Magertron already knows, then wait for the approval.
        print("Czartup was just upgraded - approving its new tools (up to a minute) ...", file=sys.stderr)
        try:
            rpc(url, token, "tools/call", {"name": "list_czarters", "arguments": {}})
        except Unapproved:
            pass
        for _ in range(20):
            time.sleep(3)
            try:
                res = rpc(url, token, "tools/call", {"name": tool, "arguments": args})
                break
            except Unapproved:
                continue
        else:
            sys.exit(f"Magertron refused this (403): {e}\n"
                     "Czartup could not approve its new tools as you (it needs an admin). "
                     "An admin opens Czartup in the console once, or presses Connect now.")
    return res.get("content") or [], bool(res.get("isError"))


def text_of(blocks):
    return "\n".join(b.get("text", "") for b in blocks if b.get("type") == "text")


def say(blocks, err):
    out = text_of(blocks).strip()
    if out:
        print(out)
    return 1 if err else 0


def opt(args, name, default=None):
    if name in args:
        i = args.index(name)
        if i + 1 >= len(args):
            sys.exit(f"{name} needs a value")
        val = args[i + 1]
        del args[i:i + 2]
        return val
    return default


def flag(args, name):
    if name in args:
        args.remove(name)
        return True
    return False


def need(args, n, what):
    if len(args) < n:
        sys.exit(f"usage: czartup {what}")
    return args[:n]


def write_pack(name, folder):
    blocks, err = call("get_handover", name=name)
    if err:
        return say(blocks, err)
    root = pathlib.Path(folder).expanduser().resolve()
    n = 0
    for b in blocks:
        r = b.get("resource") if b.get("type") == "resource" else None
        if not r:
            continue
        rel = r.get("uri", "").split("/handover/", 1)[-1]
        dest = (root / rel).resolve()
        if root not in dest.parents:              # never write outside the folder
            print(f"skipped {rel}: outside {root}")
            continue
        dest.parent.mkdir(parents=True, exist_ok=True)
        if "blob" in r:
            dest.write_bytes(base64.b64decode(r["blob"]))
        else:
            dest.write_text(r.get("text", ""))
        n += 1
    print(f"wrote {n} files of {name}'s hand-over pack into {root}")
    print(f"next: build what AGENTS.md says, then: czartup verify {name}")
    return 0


